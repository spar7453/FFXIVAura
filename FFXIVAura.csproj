<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)\</DalamudLibPath>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' == '' and Exists('$(APPDATA)\XIVLauncherKR\addon\Hooks\15.0.2.2\Dalamud.dll')">$(APPDATA)\XIVLauncherKR\addon\Hooks\15.0.2.2\</DalamudLibPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(DalamudLibPath)</AssemblySearchPaths>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FFXIVAura</AssemblyName>
    <RootNamespace>FFXIVAura</RootNamespace>
    <Version>1.0.0.1</Version>
    <AssemblyVersion>1.0.0.1</AssemblyVersion>
    <FileVersion>1.0.0.1</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FFXIVAura.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="FFXIVAura.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\abilities.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\party_cooldowns.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\abilities.json" LogicalName="FFXIVAura.Data.abilities.json" />
    <EmbeddedResource Include="Data\party_cooldowns.json" LogicalName="FFXIVAura.Data.party_cooldowns.json" />
  </ItemGroup>
</Project>
